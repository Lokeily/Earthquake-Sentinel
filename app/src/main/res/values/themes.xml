<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      主题改为 DayNight（v1.0.17）：所有颜色都走 @color/ 引用，
      深色模式下自动切到 values-night/colors.xml 的 OLED 纯黑配色，无需重复定义主题。
      状态栏图标明暗由 @bool/light_status_bar 跟随日夜切换。
    -->
    <style name="Theme.Dianguard" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorPrimaryDark">@color/ios_blue_dark</item>
        <item name="colorAccent">@color/ios_blue</item>
        <item name="android:windowBackground">@color/ios_grouped_bg</item>
        <item name="android:statusBarColor">@color/ios_grouped_bg</item>
        <item name="android:navigationBarColor">@color/ios_card_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/light_status_bar</item>

        <!-- 统一简体中文字体：所有文本（含动态震情地名）均使用 Noto Sans SC，
             避免不同设备/模拟器默认字体不一致导致“未知字体/乱码”观感。
             罕见生僻字由系统字体兜底，不影响阅读。 -->
        <item name="android:fontFamily">@font/dianguard_zh</item>
        <item name="fontFamily">@font/dianguard_zh</item>

        <!-- 统一的柔和过场：二级页面淡入淡出，避免生硬跳变。
             告警页 Theme.Dianguard.Alert 不继承本项，保持瞬时弹出（生命安全优先）。 -->
        <item name="android:windowAnimationStyle">@style/WindowAnimDianguard</item>
    </style>

    <!-- 柔和窗口过场动画（仅主应用主题引用） -->
    <style name="WindowAnimDianguard">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
        <item name="android:windowShowAnimation">@anim/fade_in</item>
        <item name="android:windowHideAnimation">@anim/fade_out</item>
    </style>

    <!-- 全屏告警主题：全屏、锁屏可见。背景色由 AlertActivity 按预警等级动态设置，
         此处仅给一个中性底色，避免等级着色生效前出现红色闪屏。
         告警页刻意**不跟随深色模式**：真实地震时必须是固定、可预期的高对比配色。 -->
    <style name="Theme.Dianguard.Alert" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <!-- 告警页同样统一简体中文字体 -->
        <item name="android:fontFamily">@font/dianguard_zh</item>
        <item name="fontFamily">@font/dianguard_zh</item>
    </style>
</resources>
