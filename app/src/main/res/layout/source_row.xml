<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="9dp">

    <View
        android:id="@+id/src_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_src_dot"
        android:backgroundTint="@color/source_gray" />

    <TextView
        android:id="@+id/src_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/ios_label"
        android:textSize="14sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/src_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/ios_label_secondary"
        android:textSize="12sp" />

</LinearLayout>
