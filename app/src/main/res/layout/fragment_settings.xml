<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页（v1.4.2 信息架构重构）：一级主设置页，只保留高频核心配置
     （参考位置 / 预警阈值（昼夜） / 外观），工具、通用、关于全部收进二级页
     fragment_more_settings.xml。根用 ScrollView，顶部悬浮提示 float_tip。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_title"
            android:textColor="@color/ios_label"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- ===================== 基础设置 ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_basic"
            android:textColor="@color/ios_label_secondary"
            android:textSize="13sp" />

        <!-- 参考位置卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_location_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_loc"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/btn_loc"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/tv_location_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:text="@string/location_display_empty"
                android:textColor="@color/ios_label"
                android:textSize="15sp" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="16dp" />

        <!-- 预警阈值卡片（昼夜各一档，随等级变色） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_threshold_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 白天烈度阈值 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/settings_threshold_intensity_day_title"
                android:textColor="@color/ios_label_secondary"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp">

                <Spinner
                    android:id="@+id/spinner_intensity_day"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tv_intensity_day_trigger"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ios_label"
                    android:textSize="15sp"
                    app:drawableEndCompat="@drawable/ic_chevron_down"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <!-- 夜间烈度阈值 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/settings_threshold_intensity_night_title"
                android:textColor="@color/ios_label_secondary"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp">

                <Spinner
                    android:id="@+id/spinner_intensity_night"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tv_intensity_night_trigger"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ios_label"
                    android:textSize="15sp"
                    app:drawableEndCompat="@drawable/ic_chevron_down"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/settings_threshold_note"
                android:textColor="@color/ios_label_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="16dp" />

        <!-- 外观 / 深色模式 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp">

                <Spinner
                    android:id="@+id/spinner_theme"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/tv_theme_trigger"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/ios_label"
                    android:textSize="15sp"
                    app:drawableEndCompat="@drawable/ic_chevron_down"
                    android:clickable="true"
                    android:focusable="true" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===================== 工具 / 更多设置入口 ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_tools"
            android:textColor="@color/ios_label_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card">

            <!-- 更多设置（下钻） -->
            <LinearLayout
                android:id="@+id/row_more_settings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/more_settings_title"
                    android:textColor="@color/ios_label"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ios_label_secondary"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>