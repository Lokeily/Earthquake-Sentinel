<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- 顶部栏：返回 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ 返回"
                android:textColor="@color/ios_blue"
                android:textSize="16sp"
                android:paddingVertical="8dp"
                android:paddingHorizontal="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="保活设置引导"
                android:textColor="@color/ios_label"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="老手机（小米/华为/OPPO/vivo/三星等）的系统会强行杀掉后台应用。务必按下方步骤把「地震哨兵」加入白名单，否则预警会失效。"
            android:textColor="@color/ios_label_secondary"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <Space android:layout_width="match_parent" android:layout_height="16dp" />

        <Button
            android:id="@+id/btn_app_details"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_primary"
            android:text="打开本应用设置（锁定/权限）"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <Space android:layout_width="match_parent" android:layout_height="10dp" />

        <Button
            android:id="@+id/btn_battery"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_secondary"
            android:text="电池优化白名单"
            android:textColor="@color/ios_blue"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <Space android:layout_width="match_parent" android:layout_height="10dp" />

        <Button
            android:id="@+id/btn_oem"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_secondary"
            android:text="尝试打开厂商自启动设置"
            android:textColor="@color/ios_blue"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <Space android:layout_width="match_parent" android:layout_height="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="分品牌手动设置步骤"
            android:textColor="@color/ios_label"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- 小米 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小米 / Redmi（MIUI / HyperOS）"
                android:textColor="@color/ios_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 安全中心 → 授权管理 → 自启动管理 → 允许「地震哨兵」自启动\n2. 设置 → 电池与性能 → 右上角设置 → 锁屏清理内存 → 设为「不清理」\n3. 设置 → 应用设置 → 地震哨兵 → 省电策略 → 无限制\n4. 多任务视图长按本应用 → 锁定（小锁图标）"
                android:textColor="@color/ios_label"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="10dp" />

        <!-- 华为 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="华为（EMUI / HarmonyOS）"
                android:textColor="@color/ios_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 手机管家 → 应用启动管理 → 地震哨兵 → 手动管理 → 允许自启动/关联启动/后台活动\n2. 设置 → 电池 → 应用耗电详情 → 地震哨兵 → 允许后台活动\n3. 多任务视图下拉本应用卡片 → 锁定"
                android:textColor="@color/ios_label"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="10dp" />

        <!-- OPPO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPPO / Realme（ColorOS）"
                android:textColor="@color/ios_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 设置 → 电池 → 应用耗电管理 → 地震哨兵 → 允许后台运行/允许自启动\n2. 手机管家 → 权限隐私 → 自启动管理 → 开启本应用\n3. 多任务视图下拉锁定"
                android:textColor="@color/ios_label"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="10dp" />

        <!-- vivo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="vivo / iQOO"
                android:textColor="@color/ios_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. i管家 → 应用管理 → 自启动管理 → 开启本应用\n2. 设置 → 电池 → 后台耗电管理 → 地震哨兵 → 允许\n3. 多任务视图下拉锁定"
                android:textColor="@color/ios_label"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="10dp" />

        <!-- 三星 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="三星（One UI）"
                android:textColor="@color/ios_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 设置 → 电池和设备维护 → 电池 → 后台使用限制 → 从不睡眠应用 → 添加本应用\n2. 设置 → 应用 → 地震哨兵 → 电池 → 不受限制\n3. 多任务视图下拉锁定"
                android:textColor="@color/ios_label"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="10dp" />

        <!-- 通用 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="通用安卓"
                android:textColor="@color/ios_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 设置 → 应用 → 地震哨兵 → 电池 → 不受限制 / 无限制\n2. 设置 → 应用 → 特殊访问 → 电池优化 → 地震哨兵 → 不优化\n3. 多任务视图长按本应用 → 锁定 / 加锁"
                android:textColor="@color/ios_label"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <Space android:layout_width="match_parent" android:layout_height="10dp" />

        <!-- Doze / 深度休眠白名单引导 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Doze 休眠白名单（所有品牌通用）"
                android:textColor="@color/ios_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Android 6.0+ 在设备静止一段时间后会进入深度休眠（Doze）模式，限制网络访问，可能导致 WebSocket 长连接断开、预警延迟。\n\n1. 本页面顶部「电池优化白名单」按钮 → 选择「所有应用」→ 地震哨兵 → 不优化\n2. 在手机「设置 → 电池」中搜索「后台限制」「休眠」「省电策略」等关键词，确保本应用不受限制\n3. 若使用省电类第三方 App（绿色守护、黑域等），将本应用加入白名单"
                android:textColor="@color/ios_label"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
