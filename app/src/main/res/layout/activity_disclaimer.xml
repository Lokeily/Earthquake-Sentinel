<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_background">

    <!-- 顶部栏：返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/ios_card_bg">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/ios_label"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/back"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tv_disclaimer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/disclaimer_title"
            android:textColor="@color/ios_label"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/ios_separator" />

    <ScrollView
        android:id="@+id/scroll_disclaimer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- ============ 第一步：用户服务协议 ============ -->
            <LinearLayout
                android:id="@+id/ll_service_agreement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/service_agreement_title"
                    android:textColor="@color/ios_label"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/service_agreement_intro"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/service_agreement_intro_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/service_agreement_s1_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/service_agreement_s1_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/service_agreement_s2_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/service_agreement_s2_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/service_agreement_s3_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/service_agreement_s3_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/service_agreement_s4_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/service_agreement_s4_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/service_agreement_s5_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/service_agreement_s5_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/service_agreement_s6_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/service_agreement_s6_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="28dp"
                android:background="@color/ios_separator" />

            </LinearLayout>
            <!-- ============ 第二步：免责声明协议 ============ -->
            <LinearLayout
                android:id="@+id/ll_disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/disclaimer_title"
                    android:textColor="@color/ios_label"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/disclaimer_intro"
                android:textColor="@color/alert_red"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_intro_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"
                android:background="@color/ios_separator" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_service"
                android:textColor="@color/ios_label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/disclaimer_section_service_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_1_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_1_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_2_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_2_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_3_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_3_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_4_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_4_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_5_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_5_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_6_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_6_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部同意栏 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/ios_separator" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/ios_card_bg">

        <TextView
            android:id="@+id/tv_read_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/agreement_read_hint"
            android:textColor="@color/ios_label_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_agree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_primary"
            android:text="@string/agreement_reading"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:enabled="false" />

        <Button
            android:id="@+id/btn_disagree"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/agreement_disagree_exit"
            android:textColor="@color/ios_label"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>
