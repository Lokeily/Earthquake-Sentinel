<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ios_grouped_bg">

    <!-- 顶部栏：返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/ios_card_bg">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_chevron_left"
            android:tint="@color/ios_label"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/back"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/disclaimer_title"
            android:textColor="@color/ios_label"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/ios_separator" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- 重要提示 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/disclaimer_intro"
                android:textColor="@color/alert_red"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_intro_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="20dp"
                android:background="@color/ios_separator" />

            <!-- 标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_service"
                android:textColor="@color/ios_label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/disclaimer_section_service_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <!-- 一、关于本服务 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_1_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_1_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <!-- 二、个人信息保护 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_2_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_2_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <!-- 三、注意事项 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_3_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_3_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <!-- 四、免责说明 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_4_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_4_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <!-- 五、第三方 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_5_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_5_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <!-- 六、法律 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer_section_6_title"
                android:textColor="@color/ios_label"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/disclaimer_section_6_text"
                android:textColor="@color/ios_label"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>