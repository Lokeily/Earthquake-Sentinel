<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_bg">

    <!-- 主内容区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- 顶栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView android:id="@+id/btn_back"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="‹ 返回" android:textColor="@color/ios_blue"
                    android:textSize="16sp" android:paddingVertical="8dp"
                    android:clickable="true" android:focusable="true" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:text="@string/test_alarm_title"
                    android:textColor="@color/ios_label" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="配置震源参数后启动完整模拟预警流程，体验首报→终报的震级渐进升级过程。"
                android:textColor="@color/ios_label_secondary" android:textSize="13sp" />

            <Space android:layout_width="match_parent" android:layout_height="20dp" />

            <!-- 完整模拟预警入口卡片 -->
            <LinearLayout android:id="@+id/card_config"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="20dp" android:clickable="true" android:focusable="true">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="完整模拟预警" android:textColor="@color/ios_label"
                    android:textSize="18sp" android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="首报震级 → 终报震级渐进升级，真实还原地震预警全流程"
                    android:textColor="@color/ios_label_secondary" android:textSize="13sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View android:layout_width="0dp" android:layout_height="1dp"
                        android:layout_weight="1" android:background="@color/ios_separator" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:text="点击配置参数" android:textColor="@color/ios_blue"
                        android:textSize="14sp" />

                    <View android:layout_width="0dp" android:layout_height="1dp"
                        android:layout_weight="1" android:background="@color/ios_separator" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 半遮蔽配置面板（默认隐藏） -->
    <LinearLayout android:id="@+id/overlay_config"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:visibility="gone"
        android:background="#CC000000">

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clickable="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout android:id="@+id/panel_config"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@color/ios_grouped_bg"
                android:padding="20dp" android:clickable="true"
                android:focusable="true">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="模拟预警配置"
                        android:textColor="@color/ios_label" android:textSize="18sp" android:textStyle="bold" />

                    <TextView android:id="@+id/btn_close_config"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✕" android:textColor="@color/ios_label_secondary"
                        android:textSize="20sp" android:padding="8dp"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>

                <!-- 首报震级 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="首报震级" android:textColor="@color/ios_label"
                    android:textSize="14sp" android:textStyle="bold" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="6dp"
                    android:gravity="center_vertical">

                    <EditText android:id="@+id/et_first_mag"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="44dp" android:background="@drawable/bg_input"
                        android:paddingHorizontal="14dp" android:text="5.0"
                        android:textColor="@color/ios_label" android:textSize="15sp"
                        android:inputType="numberDecimal" android:hint="3.0 - 8.0"
                        android:maxLines="1" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:text="级（下限 3.0 / 上限 8.0）"
                        android:textColor="@color/ios_label_secondary" android:textSize="12sp" />
                </LinearLayout>

                <Space android:layout_width="match_parent" android:layout_height="16dp" />

                <!-- 末报震级 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="末报震级（最终地震震级）" android:textColor="@color/ios_label"
                    android:textSize="14sp" android:textStyle="bold" />

                <RadioGroup android:id="@+id/rg_final_type"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:orientation="horizontal">

                    <RadioButton android:id="@+id/rb_same"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="40dp" android:text="同首报"
                        android:textColor="@color/ios_label" android:textSize="14sp"
                        android:checked="true" android:buttonTint="@color/ios_blue" />

                    <RadioButton android:id="@+id/rb_custom"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="40dp" android:text="固定值"
                        android:textColor="@color/ios_label" android:textSize="14sp"
                        android:buttonTint="@color/ios_blue" />
                </RadioGroup>

                <EditText android:id="@+id/et_final_mag"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="4dp" android:background="@drawable/bg_input"
                    android:paddingHorizontal="14dp" android:visibility="gone"
                    android:textColor="@color/ios_label" android:textSize="15sp"
                    android:inputType="numberDecimal" android:hint="3.0 - 8.0"
                    android:maxLines="1" />

                <Space android:layout_width="match_parent" android:layout_height="16dp" />

                <!-- 震源深度 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="震源深度（默认随机）" android:textColor="@color/ios_label"
                    android:textSize="14sp" android:textStyle="bold" />

                <EditText android:id="@+id/et_depth"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="6dp" android:background="@drawable/bg_input"
                    android:paddingHorizontal="14dp" android:textColor="@color/ios_label"
                    android:textSize="15sp" android:inputType="numberDecimal"
                    android:hint="随机（下限5 / 上限50 km）" android:maxLines="1" />

                <Space android:layout_width="match_parent" android:layout_height="16dp" />

                <!-- 震中距 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="震中距（默认随机）" android:textColor="@color/ios_label"
                    android:textSize="14sp" android:textStyle="bold" />

                <EditText android:id="@+id/et_distance"
                    android:layout_width="match_parent" android:layout_height="44dp"
                    android:layout_marginTop="6dp" android:background="@drawable/bg_input"
                    android:paddingHorizontal="14dp" android:textColor="@color/ios_label"
                    android:textSize="15sp" android:inputType="numberDecimal"
                    android:hint="随机（下限0 / 上限1000 km）" android:maxLines="1" />

                <Space android:layout_width="match_parent" android:layout_height="20dp" />

                <!-- 开始模拟按钮 -->
                <Button android:id="@+id/btn_start_sim"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="开始模拟（5 秒后触发）" android:textColor="#FFFFFF"
                    android:textSize="16sp" android:textStyle="bold"
                    android:textAllCaps="false" android:stateListAnimator="@null" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
