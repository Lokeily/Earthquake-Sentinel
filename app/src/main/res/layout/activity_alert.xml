<?xml version="1.0" encoding="utf-8"?>
<!--
  全屏地震预警页（v1.4.3 ICL 对齐版）。

  主视觉 = 倒计时提示横幅（ICL 式）：「地震波将于X秒后到达」大字号居中，
  每秒刷新；不再显示独立的大数字倒计时（避免同一信息两处重复）。

  信息分层（每个元素只出现一次）：
  - 顶部：预警等级横幅（等级名唯一出现处）
  - 主视觉：倒计时提示横幅（大字号，占屏幕视觉中心）
  - 中部：震中地点·震级 / 震中方位 / 一句话避险判定（按烈度·震级）
  - 底部：报数·来源·发震时刻·预估烈度·震源深度·距您X公里 + 停止警报
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_alert"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/alert_red">

    <!-- 顶部：预警等级横幅 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#4D000000"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alert_banner_prefix"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="红色预警"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 主视觉：倒计时提示横幅（大字号，占剩余空间居中） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_eta_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_eta_banner"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="地震波将于 -- 秒后到达"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- 信息区：地点·震级 / 方位 / 一句话避险判定 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="未知地区"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_direction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_guidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- 底部操作区：报数/来源/时间/烈度/深度/距离 + 停止警报 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:paddingHorizontal="16dp"
        android:background="#E6000000">

        <TextView
            android:id="@+id/tv_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_dismiss"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_alert_dismiss"
            android:text="@string/alert_dismiss"
            android:textColor="@color/ios_destructive"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>