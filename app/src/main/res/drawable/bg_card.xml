<?xml version="1.0" encoding="utf-8"?>
<!--
  卡片（v1.4.8 Liquid Glass）：所有页面统一引用本文件。
  与旧版纯色 bg_card 相比：
   - 垂直微渐变（顶部略亮）+ 顶部高光叠层，营造玻璃的"边缘受光"质感；
   - 浅色/深色各有一套透明度（values-night），深色下玻璃半透明、透出
     窗口背景的顶部环境光斑，形成半透明层次；
   - 仍为无阴影纯 drawable，旧机器零渲染成本（不做真实 blur：
     RenderEffect 需要 API 31+ 且在低端机上有可见掉帧，性价比不足）。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_hi"
                android:endColor="@color/glass_lo" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- 顶部高光叠层：从卡片顶边向下衰减，模拟玻璃上缘反光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_edge_top"
                android:endColor="@color/transparent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1px"
                android:color="@color/glass_stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
