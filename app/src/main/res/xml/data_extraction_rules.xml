<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+（API 31+）数据提取规则：与 allowBackup=false 一致，
     禁用一切云备份与设备到设备迁移，保护位置坐标与预警历史不在系统备份中外流。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>